# How often the server checks Tazkarti (seconds, minimum 10)
WATCH_INTERVAL_SECONDS=30

# Where state, subscribers and generated VAPID keys are saved. Use a persistent volume in production.
DATA_DIR=./data

# Web Push keys. Leave empty to auto-generate once into DATA_DIR/vapid.json.
# Generate your own with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Restrict which origin may call the API from a browser (default: *)
CORS_ORIGIN=

# If set, /api/check requires "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Set to 1 to stop the background loop (e.g. on a serverless host that uses /api/check via cron instead)
WATCHER_DISABLED=
